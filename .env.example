# Copy to .env.local and fill in. .env.local is gitignored via *.local.

# Supabase — anon key only. Safe in the browser; RLS protects the data.
VITE_SUPABASE_URL=https://hiwufsjnhfrzevjvfefp.supabase.co
VITE_SUPABASE_ANON_KEY=

# Razorpay — the PUBLIC key id only. The secret and the webhook secret belong
# in Supabase edge-function secrets, never here and never in the bundle.
VITE_RAZORPAY_KEY_ID=

# Shown in the header on the customer's phone. Deliberately build-time config:
# a diner's device has no shop settings, and reading the staff store here would
# drag the whole till data layer into the customer bundle.
VITE_CAFE_NAME=THANJAI CAFE

# Public origin the table QR codes point at.
VITE_PUBLIC_ORDER_URL=https://your-app.vercel.app

# Shared secret authorising the till to publish its menu. Must match the
# PUBLISH_TOKEN secret set on the publish-menu edge function. Not a customer
# secret — it only permits publishing, and the menu is public anyway — but it
# is what stops anyone who finds the function URL from rewriting your prices.
VITE_PUBLISH_TOKEN=pub_9hj02MvguzFfyRhOqjJ9seho3PuJ5ZNT

# Recorded here ONLY so a later check can confirm the value set on the
# verify-payment function matches what Razorpay was given. The app never reads
# it — note the missing VITE_ prefix, so Vite will not expose it to the browser.
RAZORPAY_WEBHOOK_SECRET=whsec_iySyksn-AEI1oh7mNB4xhx-3KUCtoYpQ
